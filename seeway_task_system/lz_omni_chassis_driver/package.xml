<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lz_omni_chassis_driver</name>
  <version>0.1.0</version>
  <description>
    ROS2 driver for the LZ_OMNI omnidirectional chassis.
    Subscribes to /cmd_vel (geometry_msgs/Twist) and communicates with the
    chassis via UART (serial) or CAN bus using the LZ_OMNI binary protocol.
  </description>
  <maintainer email="shrek117wu@gmail.com">Seeway Development Team</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>rclpy</build_depend>
  <build_depend>geometry_msgs</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- pyserial: required for UART mode (pip install pyserial) -->
  <!-- python-can: required for CAN mode  (pip install python-can) -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
